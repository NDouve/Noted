<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the sign-in token store (flutter_secure_storage's
     shared preferences) is left out of cloud backup and device-to-device
     transfer alike. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </device-transfer>
</data-extraction-rules>
